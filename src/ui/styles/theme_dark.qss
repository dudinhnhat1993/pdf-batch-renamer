/* ============================================================
   PDF Batch Renamer — theme.qss (Modern Slim / Fluent Design)
   ============================================================ */

QWidget {
    background: #0d1117;
    color: #e6edf3;
    font-family: "Be Vietnam Pro", "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 12px;
}
QWidget:disabled { color: #484f58; }

QToolTip {
    background: #161b22;
    color: #ffffff;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---------- Toolbar ---------- */
#ActionToolBar {
    background: #161b22;
    border: none;
    border-bottom: 1px solid #30363d;
    min-height: 46px;
    max-height: 46px;
    padding: 0 10px;
    spacing: 4px;
}
#ActionToolBar QToolButton,
QPushButton,
QPushButton[variant="secondary"] {
    background: #21262d;
    color: #e6edf3;
    border: 1px solid #484f58;
    border-radius: 6px;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 8px;
    font-weight: 500;
}
#ActionToolBar QToolButton {
    border-color: #30363d;
    min-width: 28px;
}
#ActionToolBar QToolButton:hover,
QPushButton:hover,
QPushButton[variant="secondary"]:hover {
    background: #262d36;
    border-color: #1f6feb;
    color: #79c0ff;
}
#ActionToolBar QToolButton:pressed,
QPushButton:pressed,
QPushButton[variant="secondary"]:pressed {
    background: #0f141a;
}
#ActionToolBar QToolButton:checked {
    background: rgba(31,111,235,0.14);
    border-color: #1f6feb;
    color: #79c0ff;
}
#ActionToolBar QToolButton:disabled,
QPushButton:disabled {
    background: #161b22;
    border-color: #21262d;
    color: #484f58;
}
#ActionToolBar QToolButton[danger="true"] { color: #ff7b72; }
#ActionToolBar QToolButton[danger="true"]:hover { border-color: #ff7b72; }
#ActionToolBar::separator {
    background: #30363d;
    width: 1px;
    margin: 10px 4px;
}

QPushButton {
    min-width: 70px;
}

QPushButton[variant="primary"],
QDialogButtonBox QPushButton:default,
QPushButton#PrimaryButton {
    background: #1f6feb;
    color: #ffffff;
    border: 1px solid #1f6feb;
    border-radius: 6px;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    min-width: 120px;
    padding: 0 16px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover,
QDialogButtonBox QPushButton:default:hover {
    background: #388bfd;
    border-color: #388bfd;
    color: #ffffff;
}
QPushButton[variant="primary"]:pressed,
QDialogButtonBox QPushButton:default:pressed {
    background: #388bfd;
}
QPushButton[variant="primary"]:disabled {
    background: #21262d;
    color: #484f58;
    border-color: #21262d;
}

QPushButton[variant="accent"] {
    background: rgba(31,111,235,0.14);
    color: #79c0ff;
    border: 1px solid #1f6feb;
    border-radius: 6px;
    min-height: 30px;
    padding: 0 8px;
    font-weight: 500;
}
QPushButton[variant="accent"]:hover { background: #1f6feb; color: #ffffff; }

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus {
    outline: none;
    border: 1px solid #1f6feb;
}

/* ---------- Screen-state bar above the queue ---------- */
#QueueStateBar {
    background: #161b22;
    border-bottom: 1px solid #30363d;
}
#QueueStateBar QLabel { color: #8b949e; font-size: 11px; font-weight: 600; }
#QueueStateBar QToolButton {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 999px;
    color: #8b949e;
    padding: 2px 9px;
    min-height: 22px;
}
#QueueStateBar QToolButton:checked {
    background: #1f6feb;
    border-color: #1f6feb;
    color: #ffffff;
}

/* ---------- Queue table ---------- */
#QueueTable {
    background: #161b22;
    alternate-background-color: #161b22;
    border: none;
    gridline-color: #21262d;
    selection-background-color: rgba(31,111,235,0.16);
    selection-color: #ffffff;
    outline: none;
}
#QueueTable::item {
    border-bottom: 1px solid #21262d;
    padding: 0 8px;
    min-height: 34px;
}
#QueueTable::item:hover    { background: #1c2128; }
#QueueTable::item:selected { background: rgba(31,111,235,0.16); color: #ffffff; }

QHeaderView::section {
    background: #0f141a;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    border-right: 1px solid #21262d;
    padding: 0 12px;
    height: 32px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { color: #ffffff; }

/* ---------- Inspector (extracted fields) ---------- */
#InspectorPanel {
    background: #0d1117;
    border-top: 1px solid #30363d;
}
#InspectorPanel QLabel[role="caption"] {
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
}
#InspectorPanel QLabel[role="path"] { color: #79c0ff; font-weight: 600; }
#FieldRow {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
}
#FieldRow:hover { border-color: #484f58; }
#FieldValueEdit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 3px 6px;
    font-family: "Cascadia Mono", "Segoe UI Mono", Consolas, monospace;
    font-size: 11px;
    color: #ffffff;
}
#FieldValueEdit:hover { border-color: #1f6feb; }
#FieldValueEdit:focus { border: 1px solid #1f6feb; background: #161b22; }

/* ---------- PDF preview dock ---------- */
#PreviewDock {
    background: #161b22;
    border-left: 1px solid #30363d;
}
#PreviewDockHeader {
    background: #161b22;
    border-bottom: 1px solid #30363d;
    min-height: 38px;
    max-height: 38px;
}
#PreviewDockHeader QToolButton {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    color: #8b949e;
    min-width: 24px;
    min-height: 24px;
    padding: 0 5px;
}
#PreviewDockHeader QToolButton:hover { border-color: #1f6feb; color: #79c0ff; }
#PreviewDockHeader QLabel { font-family: "Cascadia Mono", Consolas, monospace; font-size: 11px; color: #ffffff; font-weight: 500; }
#PdfCanvasScroll { background: #0f141a; border: none; }
#PreviewLegend { color: #8b949e; font-size: 11px; border-top: 1px solid #30363d; }

/* ---------- Log panel & status bar ---------- */
#LogHeader { background: #161b22; border-top: 1px solid #30363d; border-bottom: 1px solid #30363d; }
#LogHeader QLabel { color: #8b949e; font-size: 11px; font-weight: 600; }
#LogView {
    background: #161b22;
    border: none;
    color: #e6edf3;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    min-height: 90px;
    max-height: 200px;
}
#StatusBar {
    background: #161b22;
    border-top: 1px solid #30363d;
    color: #8b949e;
    min-height: 28px;
}
#StatusBar QLabel { color: #8b949e; font-size: 11px; font-weight: 400; }

QProgressBar {
    background: #0f141a;
    border: 1px solid #30363d;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background: #1f6feb; border-radius: 2px; }
QProgressBar[state="done"]::chunk { background: #238636; }

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox {
    background: #0d1117;
    border: 1px solid #484f58;
    border-radius: 6px;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 8px;
    color: #ffffff;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QPlainTextEdit, QTextEdit {
    background: #0d1117;
    border: 1px solid #484f58;
    border-radius: 6px;
    padding: 6px 8px;
    color: #ffffff;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #1f6feb;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #1f6feb;
    background: #161b22;
}
QLineEdit[mono="true"], QComboBox[mono="true"] {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}
QLineEdit[invalid="true"] { border-color: #ff7b72; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    selection-background-color: rgba(31,111,235,0.14);
    selection-color: #ffffff;
    padding: 3px;
}

/* ---------- CheckBox & Radio Indicators ---------- */
QCheckBox, QRadioButton {
    spacing: 7px;
    color: #e6edf3;
    font-weight: 400;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #484f58;
    background: #161b22;
}
QCheckBox::indicator { border-radius: 3.5px; }
QRadioButton::indicator { border-radius: 7.5px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #1f6feb;
    background: #262d36;
}
QCheckBox::indicator:checked {
    background: #1f6feb;
    border: 1px solid #1f6feb;
    image: url("C:/Users/Admin/Claude/Projects/PDF Batch Renamer/assets/icons/check_white.svg");
}
QRadioButton::indicator:checked {
    background: #1f6feb;
    border: 1px solid #1f6feb;
    image: url("C:/Users/Admin/Claude/Projects/PDF Batch Renamer/assets/icons/radio_white.svg");
}

/* ---------- List/Tree/Table Checkbox Indicators ---------- */
QListView::indicator, QListWidget::indicator, QTableView::indicator, QTreeView::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #484f58;
    background: #161b22;
    border-radius: 3.5px;
}
QListView::indicator:hover, QListWidget::indicator:hover, QTableView::indicator:hover {
    border-color: #1f6feb;
    background: #262d36;
}
QListView::indicator:checked, QListWidget::indicator:checked, QTableView::indicator:checked {
    background: #1f6feb;
    border: 1px solid #1f6feb;
    image: url("C:/Users/Admin/Claude/Projects/PDF Batch Renamer/assets/icons/check_white.svg");
}

QSlider::groove:horizontal { height: 4px; background: #0f141a; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #1f6feb; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #1f6feb;
    border: 2px solid #161b22;
    width: 14px; height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* ---------- Cards, group boxes, dialogs ---------- */
QGroupBox, #Card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
    background: #161b22;
}
QDialog { background: #0d1117; }
#DialogHeader { background: #161b22; border-bottom: 1px solid #30363d; }
#DialogFooter { background: #161b22; border-top: 1px solid #30363d; }
QDialogButtonBox QPushButton {
    min-width: 80px;
    min-height: 30px;
    padding: 3px 12px;
}

/* ---------- Tabs (Settings) ---------- */
QTabWidget::pane { border: 1px solid #30363d; background: #161b22; border-radius: 6px; }
QTabBar::tab {
    background: #0d1117;
    color: #8b949e;
    padding: 8px 14px;
    border: 1px solid #30363d;
    border-bottom: none;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: 500;
    font-size: 11.5px;
}
QTabBar::tab:hover { color: #ffffff; background: #262d36; }
QTabBar::tab:selected {
    color: #79c0ff;
    background: #161b22;
    font-weight: 600;
    border-top: 2px solid #1f6feb;
    border-bottom: 1px solid #161b22;
}

/* ---------- Wizard ---------- */
#WizardHeader { background: #161b22; border-bottom: 1px solid #30363d; min-height: 52px; }
#WizardStepDot {
    border-radius: 10px;
    min-width: 20px; min-height: 20px;
    background: #0f141a;
    color: #6e7681;
    font-weight: 600;
    font-size: 11px;
}
#WizardStepDot[state="current"] { background: #1f6feb; color: #ffffff; }
#WizardStepDot[state="done"]    { background: rgba(31,111,235,0.14); color: #3fb950; }
#TokenChip {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #d2a8ff;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 4px 8px;
    font-weight: 500;
}
#TokenChip:hover { border-color: #8957e5; background: rgba(31,111,235,0.14); }
#SuggestionCard {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 10px;
}
#SuggestionCard:hover { border-color: #1f6feb; }
#SuggestionCard[selected="true"] { border-color: #1f6feb; background: rgba(31,111,235,0.14); }
#DropZone {
    border: 1.5px dashed #484f58;
    border-radius: 8px;
    background: #161b22;
    color: #8b949e;
}
#DropZone[dragActive="true"] { border-color: #1f6feb; background: rgba(31,111,235,0.14); }

/* ---------- Profile list & List widgets ---------- */
#ProfileList, QListWidget {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    outline: none;
    padding: 3px;
}
#ProfileList::item, QListWidget::item {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 5px;
    margin: 2px 0;
    padding: 6px 8px;
    color: #e6edf3;
    font-weight: 400;
}
#ProfileList::item:hover, QListWidget::item:hover {
    background: #262d36;
    border-color: #484f58;
}
#ProfileList::item:selected, QListWidget::item:selected {
    background: rgba(31,111,235,0.14);
    border: 1px solid #1f6feb;
    color: #79c0ff;
    font-weight: 600;
}

/* ---------- Splitters & scrollbars ---------- */
QSplitter::handle { background: #30363d; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }
QSplitter::handle:hover { background: #1f6feb; }

QScrollBar:vertical   { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #484f58;
    border-radius: 4px;
    min-height: 24px; min-width: 24px;
}
QScrollBar::handle:hover { background: #8b949e; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
