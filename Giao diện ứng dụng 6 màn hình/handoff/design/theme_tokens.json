{
  "$schema": "internal://pdf-batch-renamer/theme-tokens-1.0",
  "version": "1.0.0",
  "font": {
    "family_ui": "Be Vietnam Pro, Segoe UI Variable, Segoe UI, sans-serif",
    "family_mono": "JetBrains Mono, Cascadia Mono, Consolas, monospace",
    "size_xs": 10,
    "size_sm": 11,
    "size_base": 13,
    "size_md": 15,
    "size_lg": 17,
    "weight_regular": 400,
    "weight_medium": 500,
    "weight_semibold": 600,
    "weight_bold": 700
  },
  "radius": { "sm": 5, "md": 6, "lg": 9, "xl": 12, "pill": 999 },
  "space": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20 },
  "metrics": {
    "toolbar_height": 50,
    "button_height": 32,
    "icon_button_size": 32,
    "table_header_height": 34,
    "table_row_height": 38,
    "statusbar_height": 30,
    "log_panel_height": 96,
    "preview_dock_ratio": 0.4,
    "nav_rail_width": 236,
    "canvas_oversampling": 2.0,
    "min_window": [1280, 800],
    "design_canvas": [1440, 900]
  },
  "themes": {
    "dark": {
      "bg": "#0d1117",
      "bg_sunken": "#0f141a",
      "card": "#161b22",
      "elevated": "#21262d",
      "elevated_hover": "#262d36",
      "row_hover": "#1c2128",
      "border": "#30363d",
      "border_subtle": "#21262d",
      "text": "#e6edf3",
      "text_strong": "#ffffff",
      "text_muted": "#8b949e",
      "text_disabled": "#484f58",
      "text_faint": "#6e7681",
      "primary": "#1f6feb",
      "primary_hover": "#388bfd",
      "primary_text": "#79c0ff",
      "primary_soft": "rgba(31,111,235,0.14)",
      "focus_ring": "rgba(31,111,235,0.25)",
      "success": "#238636",
      "success_hover": "#2ea043",
      "success_pressed": "#1a612a",
      "accent_purple": "#8957e5",
      "accent_purple_text": "#d2a8ff",
      "status": {
        "pending":    { "fg": "#58a6ff", "bg": "rgba(88,166,255,0.15)",  "border": "rgba(88,166,255,0.35)" },
        "processing": { "fg": "#d2a8ff", "bg": "rgba(163,113,247,0.15)", "border": "rgba(163,113,247,0.35)" },
        "success":    { "fg": "#3fb950", "bg": "rgba(46,160,67,0.15)",   "border": "rgba(46,160,67,0.35)" },
        "duplicate":  { "fg": "#e3b341", "bg": "rgba(210,153,34,0.15)",  "border": "rgba(210,153,34,0.35)" },
        "error":      { "fg": "#ff7b72", "bg": "rgba(248,81,73,0.15)",   "border": "rgba(248,81,73,0.35)" }
      },
      "row_error_bg": "rgba(248,81,73,0.06)",
      "row_selected_bg": "rgba(31,111,235,0.16)",
      "row_selected_marker": "#1f6feb",
      "log": { "info": "#58a6ff", "ok": "#3fb950", "warn": "#e3b341", "error": "#ff7b72", "time": "#6e7681" },
      "pdf_canvas": {
        "page_bg": "#ffffff",
        "page_shadow": "rgba(0,0,0,0.55)",
        "hover_fill": "rgba(31,111,235,0.22)",
        "hover_stroke": "#58a6ff",
        "selected_fill": "rgba(35,134,54,0.28)",
        "selected_stroke": "#2ea043",
        "zone_stroke": "#1f6feb",
        "zone_fill": "rgba(31,111,235,0.12)"
      }
    },
    "light": {
      "bg": "#f6f8fa",
      "bg_sunken": "#eef1f4",
      "card": "#ffffff",
      "elevated": "#f6f8fa",
      "elevated_hover": "#eef1f4",
      "row_hover": "#f6f8fa",
      "border": "#d0d7de",
      "border_subtle": "#eaeef2",
      "text": "#1f2328",
      "text_strong": "#010409",
      "text_muted": "#57606a",
      "text_disabled": "#8c959f",
      "text_faint": "#6e7781",
      "primary": "#0969da",
      "primary_hover": "#0a5cc4",
      "primary_text": "#0969da",
      "primary_soft": "rgba(9,105,218,0.08)",
      "focus_ring": "rgba(9,105,218,0.25)",
      "success": "#1f883d",
      "success_hover": "#1a7f37",
      "success_pressed": "#166a2e",
      "accent_purple": "#8250df",
      "accent_purple_text": "#6639ba",
      "status": {
        "pending":    { "fg": "#0969da", "bg": "rgba(9,105,218,0.10)",  "border": "rgba(9,105,218,0.30)" },
        "processing": { "fg": "#8250df", "bg": "rgba(130,80,223,0.10)", "border": "rgba(130,80,223,0.30)" },
        "success":    { "fg": "#1f883d", "bg": "rgba(31,136,61,0.10)",  "border": "rgba(31,136,61,0.30)" },
        "duplicate":  { "fg": "#9a6700", "bg": "rgba(154,103,0,0.10)",  "border": "rgba(154,103,0,0.30)" },
        "error":      { "fg": "#cf222e", "bg": "rgba(207,34,46,0.10)",  "border": "rgba(207,34,46,0.30)" }
      },
      "row_error_bg": "rgba(207,34,46,0.05)",
      "row_selected_bg": "rgba(9,105,218,0.10)",
      "row_selected_marker": "#0969da",
      "log": { "info": "#0969da", "ok": "#1f883d", "warn": "#9a6700", "error": "#cf222e", "time": "#6e7781" },
      "pdf_canvas": {
        "page_bg": "#ffffff",
        "page_shadow": "rgba(31,35,40,0.14)",
        "hover_fill": "rgba(9,105,218,0.16)",
        "hover_stroke": "#0969da",
        "selected_fill": "rgba(31,136,61,0.18)",
        "selected_stroke": "#1f883d",
        "zone_stroke": "#0969da",
        "zone_fill": "rgba(9,105,218,0.10)"
      }
    }
  },
  "status_map": {
    "PENDING": { "label": "Chờ", "token": "pending" },
    "PROCESSING": { "label": "Đang xử lý", "token": "processing" },
    "SUCCESS": { "label": "Thành công", "token": "success" },
    "DUPLICATE": { "label": "Trùng lặp", "token": "duplicate" },
    "ERROR": { "label": "Lỗi", "token": "error" }
  }
}
