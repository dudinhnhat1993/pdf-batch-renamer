      "primary_soft": "rgba(2,132,199,0.08)",
      "focus_ring": "rgba(2,132,199,0.25)",
      "success": "#16a34a",
      "success_hover": "#15803d",
      "success_pressed": "#166534",
      "accent_purple": "#7c3aed",
      "accent_purple_text": "#6d28d9",
      "status": {
        "pending": {
          "fg": "#0284c7",
          "bg": "rgba(2,132,199,0.08)",
          "border": "rgba(2,132,199,0.25)"
        },
        "processing": {
          "fg": "#7c3aed",
          "bg": "rgba(124,58,237,0.08)",
          "border": "rgba(124,58,237,0.25)"
        },
        "success": {
          "fg": "#16a34a",
          "bg": "rgba(22,163,74,0.08)",
          "border": "rgba(22,163,74,0.25)"
        },
        "duplicate": {
          "fg": "#d97706",
          "bg": "rgba(217,119,6,0.08)",
          "border": "rgba(217,119,6,0.25)"
        },
        "error": {
          "fg": "#dc2626",
          "bg": "rgba(220,38,38,0.08)",
          "border": "rgba(220,38,38,0.25)"
        }
      },
      "row_error_bg": "rgba(220,38,38,0.04)",
      "row_selected_bg": "rgba(2,132,199,0.08)",
      "row_selected_marker": "#0284c7",
      "log": {
        "info": "#0284c7",
        "ok": "#16a34a",
        "warn": "#d97706",
        "error": "#dc2626",
        "time": "#94a3b8"
      },
      "pdf_canvas": {
        "page_bg": "#ffffff",
        "page_shadow": "rgba(15,23,42,0.10)",
        "hover_fill": "rgba(2,132,199,0.14)",
        "hover_stroke": "#0284c7",
        "selected_fill": "rgba(22,163,74,0.15)",
        "selected_stroke": "#16a34a",
        "zone_stroke": "#0284c7",
        "zone_fill": "rgba(2,132,199,0.08)"
      }
    }
  },
  "status_map": {
    "PENDING": {
      "label": "Chờ",
      "token": "pending"
    },
    "PROCESSING": {
      "label": "Đang xử lý",
      "token": "processing"
    },
    "SUCCESS": {
      "label": "Thành công",
      "token": "success"
    },
    "DUPLICATE": {
      "label": "Trùng lặp",
      "token": "duplicate"
    },
    "ERROR": {
      "label": "Lỗi",
      "token": "error"
    }
  }
}