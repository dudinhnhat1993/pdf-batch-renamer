/* ============================================================
   PDF Batch Renamer — theme.qss (template)
   Placeholders @token@ are substituted at runtime by src/ui/theme.py
   from design/theme_tokens.json. Generated copies for review:
   theme_dark.qss / theme_light.qss (do not hand-edit those).
   ============================================================ */

QWidget {
    background: @bg@;
    color: @text@;
    font-family: "Be Vietnam Pro", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: @size_base@px;
}
QWidget:disabled { color: @text_disabled@; }

QToolTip {
    background: @card@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: 5px 8px;
}

/* ---------- Toolbar ---------- */
#ActionToolBar {
    background: @card@;
    border: none;
    border-bottom: 1px solid @border@;
    min-height: @toolbar_height@px;
    max-height: @toolbar_height@px;
    padding: 0 12px;
    spacing: 6px;
}
#ActionToolBar QToolButton,
QPushButton[variant="secondary"] {
    background: @elevated@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    min-height: @button_height@px;
    max-height: @button_height@px;
    padding: 0 11px;
    font-weight: 500;
}
#ActionToolBar QToolButton:hover,
QPushButton[variant="secondary"]:hover {
    background: @elevated_hover@;
    border-color: @primary_text@;
}
#ActionToolBar QToolButton:pressed,
QPushButton[variant="secondary"]:pressed { background: @bg_sunken@; }
#ActionToolBar QToolButton:checked {
    background: @primary_soft@;
    border-color: @primary@;
    color: @primary_text@;
}
#ActionToolBar QToolButton:disabled,
QPushButton:disabled {
    background: @card@;
    border-color: @border_subtle@;
    color: @text_disabled@;
}
#ActionToolBar QToolButton[danger="true"] { color: @status_error_fg@; }
#ActionToolBar QToolButton[danger="true"]:hover { border-color: @status_error_fg@; }
#ActionToolBar::separator {
    background: @border@;
    width: 1px;
    margin: 13px 4px;
}

QPushButton[variant="primary"] {
    background: @success@;
    color: #ffffff;
    border: 1px solid @success_hover@;
    border-radius: @radius_md@px;
    min-height: @button_height@px;
    padding: 0 16px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover  { background: @success_hover@; }
QPushButton[variant="primary"]:pressed{ background: @success_pressed@; }
QPushButton[variant="primary"]:disabled { background: @elevated@; color: @text_disabled@; border-color: @border_subtle@; }

QPushButton[variant="accent"] {
    background: @primary_soft@;
    color: @primary_text@;
    border: 1px solid @primary@;
    border-radius: @radius_md@px;
    min-height: @button_height@px;
    padding: 0 13px;
    font-weight: 500;
}
QPushButton[variant="accent"]:hover { background: @primary@; color: #ffffff; }

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus {
    outline: none;
    border: 1px solid @primary@;
}

/* ---------- Screen-state bar above the queue ---------- */
#QueueStateBar {
    background: @bg_sunken@;
    border-bottom: 1px solid @border_subtle@;
}
#QueueStateBar QLabel { color: @text_faint@; font-size: @size_sm@px; font-weight: 600; }
#QueueStateBar QToolButton {
    background: @card@;
    border: 1px solid @border@;
    border-radius: @radius_pill@px;
    color: @text_muted@;
    padding: 3px 10px;
    min-height: 24px;
}
#QueueStateBar QToolButton:checked {
    background: @primary@;
    border-color: @primary@;
    color: #ffffff;
}

/* ---------- Queue table ---------- */
#QueueTable {
    background: @bg@;
    alternate-background-color: @bg@;
    border: none;
    gridline-color: transparent;
    selection-background-color: @row_selected_bg@;
    selection-color: @text@;
    outline: none;
}
#QueueTable::item {
    border-bottom: 1px solid @border_subtle@;
    padding: 0 10px;
    min-height: @table_row_height@px;
}
#QueueTable::item:hover    { background: @row_hover@; }
#QueueTable::item:selected { background: @row_selected_bg@; color: @text@; }

QHeaderView::section {
    background: @card@;
    color: @text_muted@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 0 10px;
    height: @table_header_height@px;
    font-size: @size_sm@px;
    font-weight: 600;
}
QHeaderView::section:hover { color: @text@; }

/* ---------- Inspector (extracted fields) ---------- */
#InspectorPanel {
    background: @bg@;
    border-top: 1px solid @border@;
}
#InspectorPanel QLabel[role="caption"] {
    color: @text_muted@;
    font-size: @size_sm@px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
#InspectorPanel QLabel[role="path"] { color: @primary_text@; }
#FieldRow {
    background: @card@;
    border: 1px solid @border_subtle@;
    border-radius: 7px;
}
#FieldRow:hover { border-color: @border@; }
#FieldValueEdit {
    background: @bg@;
    border: 1px solid @border@;
    border-radius: @radius_sm@px;
    padding: 4px 8px;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: @text@;
}
#FieldValueEdit:hover { border-color: @primary@; }
#FieldValueEdit:focus { border: 1px solid @primary@; background: @bg_sunken@; }

/* ---------- PDF preview dock ---------- */
#PreviewDock {
    background: @card@;
    border-left: 1px solid @border@;
}
#PreviewDockHeader {
    background: @card@;
    border-bottom: 1px solid @border@;
    min-height: 42px;
    max-height: 42px;
}
#PreviewDockHeader QToolButton {
    background: transparent;
    border: 1px solid @border@;
    border-radius: @radius_sm@px;
    color: @text_muted@;
    min-width: 24px;
    min-height: 24px;
    padding: 0 6px;
}
#PreviewDockHeader QToolButton:hover { border-color: @primary_text@; color: @primary_text@; }
#PreviewDockHeader QLabel { font-family: "JetBrains Mono", Consolas, monospace; font-size: @size_sm@px; color: @text_muted@; }
#PdfCanvasScroll { background: @bg@; border: none; }
#PreviewLegend { color: @text_muted@; font-size: @size_sm@px; border-top: 1px solid @border@; }

/* ---------- Log panel & status bar ---------- */
#LogHeader { background: @card@; border-top: 1px solid @border@; border-bottom: 1px solid @border_subtle@; }
#LogHeader QLabel { color: @text_muted@; font-size: @size_sm@px; font-weight: 600; }
#LogView {
    background: @bg@;
    border: none;
    color: @text@;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: @size_sm@px;
    min-height: @log_panel_height@px;
    max-height: 220px;
}
#StatusBar {
    background: @card@;
    border-top: 1px solid @border_subtle@;
    color: @text_muted@;
    min-height: @statusbar_height@px;
}
#StatusBar QLabel { color: @text_muted@; font-size: @size_sm@px; }

QProgressBar {
    background: @elevated@;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background: @primary@; border-radius: 3px; }
QProgressBar[state="done"]::chunk { background: @success@; }

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: @bg@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 6px 11px;
    min-height: @button_height@px;
    color: @text@;
    selection-background-color: @primary@;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: @text_muted@; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid @primary@; }
QLineEdit[mono="true"], QComboBox[mono="true"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 12px;
}
QLineEdit[invalid="true"] { border-color: @status_error_fg@; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: @card@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    selection-background-color: @primary_soft@;
    selection-color: @text@;
    padding: 4px;
}

QCheckBox, QRadioButton { spacing: 8px; color: @text@; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 1px solid @text_faint@;
    background: @bg@;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @primary@; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @primary@;
    border-color: @primary@;
}

QSlider::groove:horizontal { height: 5px; background: @elevated@; border-radius: 3px; }
QSlider::sub-page:horizontal { background: @primary@; border-radius: 3px; }
QSlider::handle:horizontal {
    background: @text@;
    width: 15px; height: 15px;
    margin: -5px 0;
    border-radius: 8px;
}

/* ---------- Cards, group boxes, dialogs ---------- */
QGroupBox, #Card {
    background: @card@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
    margin-top: 10px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: @text_muted@;
    font-size: @size_sm@px;
    font-weight: 600;
}
QDialog { background: @card@; }
#DialogHeader { border-bottom: 1px solid @border@; }
#DialogFooter { border-top: 1px solid @border@; }

/* ---------- Tabs (Settings) ---------- */
QTabWidget::pane { border: none; border-top: 1px solid @border@; }
QTabBar::tab {
    background: transparent;
    color: @text_muted@;
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabBar::tab:hover { color: @text@; }
QTabBar::tab:selected {
    color: @text@;
    font-weight: 600;
    border-bottom: 2px solid @primary@;
}

/* ---------- Wizard ---------- */
#WizardHeader { background: @card@; border-bottom: 1px solid @border@; min-height: 56px; }
#WizardStepDot {
    border-radius: 11px;
    min-width: 22px; min-height: 22px;
    background: @elevated@;
    color: @text_faint@;
    font-weight: 700;
    font-size: @size_sm@px;
}
#WizardStepDot[state="current"] { background: @primary@; color: #ffffff; }
#WizardStepDot[state="done"]    { background: @primary_soft@; color: @status_success_fg@; }
#TokenChip {
    background: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    color: @accent_purple_text@;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: @size_sm@px;
    padding: 6px 10px;
}
#TokenChip:hover { border-color: @accent_purple@; background: @primary_soft@; }
#SuggestionCard {
    background: @bg@;
    border: 1px solid @border_subtle@;
    border-radius: 8px;
    padding: 9px 11px;
}
#SuggestionCard:hover { border-color: @border@; }
#SuggestionCard[selected="true"] { border-color: @primary@; background: @primary_soft@; }
#DropZone {
    border: 2px dashed @border@;
    border-radius: @radius_lg@px;
    background: @bg_sunken@;
    color: @text_muted@;
}
#DropZone[dragActive="true"] { border-color: @primary@; background: @primary_soft@; }

/* ---------- Profile list ---------- */
#ProfileList { background: @bg@; border: none; outline: none; }
#ProfileList::item {
    background: @card@;
    border: 1px solid @border_subtle@;
    border-radius: 8px;
    margin: 3px 0;
    padding: 10px 11px;
}
#ProfileList::item:hover    { border-color: @border@; }
#ProfileList::item:selected { background: @primary_soft@; border-color: @primary@; color: @text@; }

/* ---------- Splitters & scrollbars ---------- */
QSplitter::handle { background: @border@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }
QSplitter::handle:hover { background: @primary@; }

QScrollBar:vertical   { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @border@;
    border-radius: 5px;
    min-height: 28px; min-width: 28px;
}
QScrollBar::handle:hover { background: @text_faint@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QMenu {
    background: @card@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
    padding: 5px;
}
QMenu::item { padding: 7px 14px; border-radius: @radius_sm@px; color: @text@; }
QMenu::item:selected { background: @primary_soft@; color: @primary_text@; }
QMenu::separator { height: 1px; background: @border_subtle@; margin: 4px 8px; }
