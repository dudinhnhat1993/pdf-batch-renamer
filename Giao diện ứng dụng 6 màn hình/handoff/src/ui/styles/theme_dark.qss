/* ============================================================
   PDF Batch Renamer — theme_dark.qss (GENERATED — do not edit)
   GENERATED from src/ui/styles/theme.qss + design/theme_tokens.json
   mode = "dark" · tokens v1.0.0 · do not hand-edit; edit the template.
   ============================================================ */

QWidget {
    background: #0d1117;
    color: #e6edf3;
    font-family: "Be Vietnam Pro", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
}
QWidget:disabled { color: #484f58; }

QToolTip {
    background: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---------- Toolbar ---------- */
#ActionToolBar {
    background: #161b22;
    border: none;
    border-bottom: 1px solid #30363d;
    min-height: 50px;
    max-height: 50px;
    padding: 0 12px;
    spacing: 6px;
}
#ActionToolBar QToolButton,
QPushButton[variant="secondary"] {
    background: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 11px;
    font-weight: 500;
}
#ActionToolBar QToolButton:hover,
QPushButton[variant="secondary"]:hover {
    background: #262d36;
    border-color: #79c0ff;
}
#ActionToolBar QToolButton:pressed,
QPushButton[variant="secondary"]:pressed { background: #0f141a; }
#ActionToolBar QToolButton:checked {
    background: rgba(31,111,235,0.14);
    border-color: #1f6feb;
    color: #79c0ff;
}
#ActionToolBar QToolButton:disabled,
QPushButton:disabled {
    background: #161b22;
    border-color: #21262d;
    color: #484f58;
}
#ActionToolBar QToolButton[danger="true"] { color: #ff7b72; }
#ActionToolBar QToolButton[danger="true"]:hover { border-color: #ff7b72; }
#ActionToolBar::separator {
    background: #30363d;
    width: 1px;
    margin: 13px 4px;
}

QPushButton[variant="primary"] {
    background: #238636;
    color: #ffffff;
    border: 1px solid #2ea043;
    border-radius: 6px;
    min-height: 32px;
    padding: 0 16px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover  { background: #2ea043; }
QPushButton[variant="primary"]:pressed{ background: #1a612a; }
QPushButton[variant="primary"]:disabled { background: #21262d; color: #484f58; border-color: #21262d; }

QPushButton[variant="accent"] {
    background: rgba(31,111,235,0.14);
    color: #79c0ff;
    border: 1px solid #1f6feb;
    border-radius: 6px;
    min-height: 32px;
    padding: 0 13px;
    font-weight: 500;
}
QPushButton[variant="accent"]:hover { background: #1f6feb; color: #ffffff; }

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus {
    outline: none;
    border: 1px solid #1f6feb;
}

/* ---------- Screen-state bar above the queue ---------- */
#QueueStateBar {
    background: #0f141a;
    border-bottom: 1px solid #21262d;
}
#QueueStateBar QLabel { color: #6e7681; font-size: 11px; font-weight: 600; }
#QueueStateBar QToolButton {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 999px;
    color: #8b949e;
    padding: 3px 10px;
    min-height: 24px;
}
#QueueStateBar QToolButton:checked {
    background: #1f6feb;
    border-color: #1f6feb;
    color: #ffffff;
}

/* ---------- Queue table ---------- */
#QueueTable {
    background: #0d1117;
    alternate-background-color: #0d1117;
    border: none;
    gridline-color: transparent;
    selection-background-color: rgba(31,111,235,0.16);
    selection-color: #e6edf3;
    outline: none;
}
#QueueTable::item {
    border-bottom: 1px solid #21262d;
    padding: 0 10px;
    min-height: 38px;
}
#QueueTable::item:hover    { background: #1c2128; }
#QueueTable::item:selected { background: rgba(31,111,235,0.16); color: #e6edf3; }

QHeaderView::section {
    background: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    padding: 0 10px;
    height: 34px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { color: #e6edf3; }

/* ---------- Inspector (extracted fields) ---------- */
#InspectorPanel {
    background: #0d1117;
    border-top: 1px solid #30363d;
}
#InspectorPanel QLabel[role="caption"] {
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
#InspectorPanel QLabel[role="path"] { color: #79c0ff; }
#FieldRow {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 7px;
}
#FieldRow:hover { border-color: #30363d; }
#FieldValueEdit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px 8px;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #e6edf3;
}
#FieldValueEdit:hover { border-color: #1f6feb; }
#FieldValueEdit:focus { border: 1px solid #1f6feb; background: #0f141a; }

/* ---------- PDF preview dock ---------- */
#PreviewDock {
    background: #161b22;
    border-left: 1px solid #30363d;
}
#PreviewDockHeader {
    background: #161b22;
    border-bottom: 1px solid #30363d;
    min-height: 42px;
    max-height: 42px;
}
#PreviewDockHeader QToolButton {
    background: transparent;
    border: 1px solid #30363d;
    border-radius: 5px;
    color: #8b949e;
    min-width: 24px;
    min-height: 24px;
    padding: 0 6px;
}
#PreviewDockHeader QToolButton:hover { border-color: #79c0ff; color: #79c0ff; }
#PreviewDockHeader QLabel { font-family: "JetBrains Mono", Consolas, monospace; font-size: 11px; color: #8b949e; }
#PdfCanvasScroll { background: #0d1117; border: none; }
#PreviewLegend { color: #8b949e; font-size: 11px; border-top: 1px solid #30363d; }

/* ---------- Log panel & status bar ---------- */
#LogHeader { background: #161b22; border-top: 1px solid #30363d; border-bottom: 1px solid #21262d; }
#LogHeader QLabel { color: #8b949e; font-size: 11px; font-weight: 600; }
#LogView {
    background: #0d1117;
    border: none;
    color: #e6edf3;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 11px;
    min-height: 96px;
    max-height: 220px;
}
#StatusBar {
    background: #161b22;
    border-top: 1px solid #21262d;
    color: #8b949e;
    min-height: 30px;
}
#StatusBar QLabel { color: #8b949e; font-size: 11px; }

QProgressBar {
    background: #21262d;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background: #1f6feb; border-radius: 3px; }
QProgressBar[state="done"]::chunk { background: #238636; }

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 7px;
    padding: 6px 11px;
    min-height: 32px;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #8b949e; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #1f6feb; }
QLineEdit[mono="true"], QComboBox[mono="true"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 12px;
}
QLineEdit[invalid="true"] { border-color: #ff7b72; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    selection-background-color: rgba(31,111,235,0.14);
    selection-color: #e6edf3;
    padding: 4px;
}

QCheckBox, QRadioButton { spacing: 8px; color: #e6edf3; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 1px solid #6e7681;
    background: #0d1117;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #1f6feb; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #1f6feb;
    border-color: #1f6feb;
}

QSlider::groove:horizontal { height: 5px; background: #21262d; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #1f6feb; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #e6edf3;
    width: 15px; height: 15px;
    margin: -5px 0;
    border-radius: 8px;
}

/* ---------- Cards, group boxes, dialogs ---------- */
QGroupBox, #Card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 9px;
    margin-top: 10px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
}
QDialog { background: #161b22; }
#DialogHeader { border-bottom: 1px solid #30363d; }
#DialogFooter { border-top: 1px solid #30363d; }

/* ---------- Tabs (Settings) ---------- */
QTabWidget::pane { border: none; border-top: 1px solid #30363d; }
QTabBar::tab {
    background: transparent;
    color: #8b949e;
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabBar::tab:hover { color: #e6edf3; }
QTabBar::tab:selected {
    color: #e6edf3;
    font-weight: 600;
    border-bottom: 2px solid #1f6feb;
}

/* ---------- Wizard ---------- */
#WizardHeader { background: #161b22; border-bottom: 1px solid #30363d; min-height: 56px; }
#WizardStepDot {
    border-radius: 11px;
    min-width: 22px; min-height: 22px;
    background: #21262d;
    color: #6e7681;
    font-weight: 700;
    font-size: 11px;
}
#WizardStepDot[state="current"] { background: #1f6feb; color: #ffffff; }
#WizardStepDot[state="done"]    { background: rgba(31,111,235,0.14); color: #3fb950; }
#TokenChip {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #d2a8ff;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 11px;
    padding: 6px 10px;
}
#TokenChip:hover { border-color: #8957e5; background: rgba(31,111,235,0.14); }
#SuggestionCard {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 9px 11px;
}
#SuggestionCard:hover { border-color: #30363d; }
#SuggestionCard[selected="true"] { border-color: #1f6feb; background: rgba(31,111,235,0.14); }
#DropZone {
    border: 2px dashed #30363d;
    border-radius: 9px;
    background: #0f141a;
    color: #8b949e;
}
#DropZone[dragActive="true"] { border-color: #1f6feb; background: rgba(31,111,235,0.14); }

/* ---------- Profile list ---------- */
#ProfileList { background: #0d1117; border: none; outline: none; }
#ProfileList::item {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    margin: 3px 0;
    padding: 10px 11px;
}
#ProfileList::item:hover    { border-color: #30363d; }
#ProfileList::item:selected { background: rgba(31,111,235,0.14); border-color: #1f6feb; color: #e6edf3; }

/* ---------- Splitters & scrollbars ---------- */
QSplitter::handle { background: #30363d; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }
QSplitter::handle:hover { background: #1f6feb; }

QScrollBar:vertical   { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-height: 28px; min-width: 28px;
}
QScrollBar::handle:hover { background: #6e7681; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QMenu {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 9px;
    padding: 5px;
}
QMenu::item { padding: 7px 14px; border-radius: 5px; color: #e6edf3; }
QMenu::item:selected { background: rgba(31,111,235,0.14); color: #79c0ff; }
QMenu::separator { height: 1px; background: #21262d; margin: 4px 8px; }
